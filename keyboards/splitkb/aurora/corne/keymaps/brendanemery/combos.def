// Alternate reference layers by layer
//               Layer     Reference layer
COMBO_REF_LAYER(1, 0)  // Use the combos in the 0th layer when on the 1st layer
COMBO_REF_LAYER(3, 2)  // Use the combos in the 3rd layer when on the 2nd layer

//   name     result    chord keys

// BASE / NUMBER layers
COMB(AT_SYMBOL, KC_AT, KC_D, LCTL_T(KC_T))
COMB(HASH, KC_HASH, KC_U, KC_O)
COMB(DOLLAR, KC_DLR, LALT_T(KC_I), LGUI_T(KC_C))
COMB(EQUALS, KC_EQL, LSFT_T(KC_H), KC_M)
COMB(PERCENTAGE, KC_PERC, KC_O, LCTL_T(KC_E))
COMB(AMPERSAND, KC_AMPR, KC_D, KC_L)
COMB(OPEN_BRACKET, KC_LPRN, LSFT_T(KC_A), LCTL_T(KC_E))
COMB(CLOSE_BRACKET, KC_RPRN, LCTL_T(KC_E), LALT_T(KC_I))
COMB(OPEN_SQUARE_BRACKET, KC_LBRC, KC_DOT, KC_EXLM)
COMB(CLOSE_SQUARE_BRACKET, KC_RBRC, KC_EXLM, KC_GRV)
COMB(PLUS, KC_PLUS, KC_L, LSFT_T(KC_H))
COMB(UNDERSCORE, KC_UNDS, LGUI_T(KC_S), LALT_T(KC_N))
COMB(MINUS, KC_MINS, LSFT_T(KC_A), KC_U)
COMB(ASTERISK, KC_ASTR, LALT_T(KC_N), LCTL_T(KC_T))
COMB(ESCAPE, KC_ESC, LCTL_T(KC_T), LSFT_T(KC_H))
COMB(SEMICOLON, KC_SCLN, LSFT_T(KC_A), KC_DOT)
COMB(COPY, KC_COPY, KC_P, KC_G)
COMB(CUT, KC_CUT, KC_G, KC_M)
COMB(PASTE, KC_PSTE, KC_P, KC_M)

// NAVIGATION / MOUSE
COMB(HOME, KC_HOME, KC_LGUI, KC_LALT)
COMB(END, KC_END, KC_UP, KC_RGHT)